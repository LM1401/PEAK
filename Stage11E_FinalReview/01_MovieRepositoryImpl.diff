+
+    private class RefCountedMutex {
+        val mutex = Mutex()
+        var count = 0
+    }
+    private val altLogoMutexMap = ConcurrentHashMap<String, RefCountedMutex>()
+
+    private suspend inline fun <T> withAltLogoLock(key: String, crossinline action: suspend () -> T): T {
+        val refMutex = synchronized(altLogoMutexMap) {
+            val rm = altLogoMutexMap.getOrPut(key) { RefCountedMutex() }
+            rm.count++
+            rm
+        }
+        return try {
+            refMutex.mutex.withLock {
+                action()
+            }
+        } finally {
+            synchronized(altLogoMutexMap) {
+                val rm = altLogoMutexMap[key]
+                if (rm != null) {
+                    rm.count--
+                    if (rm.count <= 0) {
+                        altLogoMutexMap.remove(key)
+                    }
+                }
+            }
+        }
+    }
